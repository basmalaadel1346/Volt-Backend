{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Assessment": {
    "InProgressAttemptTimeoutMinutes": 180,
    "AbandonedAttemptSweepIntervalMinutes": 15,
    "AiHintTimeoutSeconds": 15,
    "PlacementQuestionsPerLevel": 4,
    "PlacementPassPercentage": 75,
    "EssayAnswerMaxLength": 4000,
    "AiSendImageContent": false,
    "AiMaxImageBytes": 1000000,
    "MaxHintLength": 400,
    "MaxEssayFeedbackLength": 1000,
    "EssayEvaluationIntervalMinutes": 2,
    "EssayEvaluationMaxAttempts": 5,
    "EssayEvaluationRetryMinutes": 10,
    "EssayEvaluationTimeoutSeconds": 30,
    "EssayInlineGraceMinutes": 5
  },
  "Ai": {
    "HintsEndpoint": "",
    "EssayEvaluationEndpoint": "",
    "ApiKeyHeaderName": "X-Api-Key"
  }
}
